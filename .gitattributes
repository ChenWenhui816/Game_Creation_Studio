# 统一行尾：仓库内文本一律 LF，检出时按 LF 写入（Windows 也一样）
* text=auto eol=lf

# 文本类：显式声明 LF，避免 Windows 下 `core.autocrlf` 造成整文件 diff
*.md      text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.csv     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.txt     text eol=lf
*.toml    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.sh      text eol=lf
.github/** text eol=lf

# 图片：按二进制处理，禁止行尾转换与文本 diff
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.tga     binary
*.tif     binary
*.tiff    binary

# Office 文档
*.docx    binary
*.xlsx    binary
*.pptx    binary
*.doc     binary
*.xls     binary
*.ppt     binary

# 3D / 引擎资产
*.fbx     binary
*.glb     binary
*.gltf    text eol=lf
*.blend   binary
*.uasset  binary
*.umap    binary
*.obj     text eol=lf
*.mtl     text eol=lf

# 音频与视频
*.wav     binary
*.mp3     binary
*.ogg     binary
*.flac    binary
*.mp4     binary
*.mov     binary

# 压缩包
*.zip     binary
*.7z      binary

# 脚本：bat/ps1 按 CRLF 检出（Windows 上双击/直接执行更稳）
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# GitHub 会自动把以下文件识别为二进制/语言，无需额外声明
# LICENSE / README.md / SKILL.md 等按上面的 *.md 规则处理
