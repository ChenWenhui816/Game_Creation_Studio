<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: main executable inside the GitHub artifact ZIP.
     Create in SignPath project as Artifact Configuration slug "app". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Game_Creation_Studio.exe"
             product-name="Game Creation Studio UE"
             product-version="${version}"
             file-version="${version}"
             company-name="Game Creation Studio"
             description="Game Creation Studio UE desktop console">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
