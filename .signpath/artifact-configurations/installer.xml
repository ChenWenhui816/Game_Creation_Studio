<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: Inno Setup installer inside the GitHub artifact ZIP.
     Create in SignPath project as Artifact Configuration slug "installer". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*setup.exe"
             product-name="Personal Game Studio UE"
             product-version="${version}"
             file-version="${version}"
             company-name="Personal Game Studio"
             description="Personal Game Studio UE installer">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
